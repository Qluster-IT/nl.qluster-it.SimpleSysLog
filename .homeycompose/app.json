  "api": {  
    "internal": {
      "method": "POST",
      "path": "/internal/"
    },
    "getLogDownloadUrl": {
      "method": "GET",
      "path": "/getlogdownloadurl/:returnType",
      "public": true
    },
    "getLogs": {
      "method": "GET",
      "path": "/",
      "public": true
    },
    "queryLogs": {
      "method": "POST",
      "path": "/"
    },
    "clearLog": {
      "method": "GET",
      "path": "/clearlog/"
    },
    "addLog": {
      "method": "PUT",
      "path": "/addlog/"
    }
  }
