      "title": {
        "en": "Format",
        "nl": "Format"
      },
      "values": [
        {
          "id": "json",
          "label": {
            "en": "JSON"
          }
        },
        {
          "id": "json_base64",
          "label": {
            "en": "JSON (base64)"
          }
        },
        {
          "id": "csv",
          "label": {
            "en": "CSV"
          }
        },
        {
          "id": "csv_base64",
          "label": {
            "en": "CSV (base64)"
          }
        },
        {
          "id": "xlsx_base64",
          "label": {
            "en": "Excel (base64)"
          }
        }
      ]
    }
  ],
  "tokens": [
    {
      "name": "log",
      "type": "string",
      "title": {
        "en": "Log"
      },
      "example": "[\n  {\n    \"data\": \"Cleared all logging data\",\n    \"group\": \"Simple LOG\",\n    \"date\": \"2022-12-29T09:38:30.249Z\"\n  },\n  {\n    \"data\": \"badkamer: 60\",\n    \"date\": \"2022-12-29T09:39:32.172Z\"\n  },"
    }
  ]
}