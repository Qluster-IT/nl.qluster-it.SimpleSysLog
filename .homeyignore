# Files that are not needed by the Homey app at runtime.

# Repository, editor and agent files
/.github/
/.vscode/
/.gitignore
/.homeyignore
/AGENTS.md

# Homey Compose sources and build output (compiled into app.json and locales/)
/.homeycompose/
/.homeyplugins.json
/.homeybuild/

# Development dependencies and tests
/package-lock.json
/test/

# Documentation (App Store descriptions use README.txt)
/README.md

# Unused code and development notes
/filetypes.txt
/helpers
/json flows
/todo.txt
/translate.json

# Unused assets (source images for the PNGs used by the settings page)
/settings/date.svg
/settings/font.svg
/settings/refresh.svg
/settings/sort.svg
/settings/time.svg
/settings/download.png
